rules_version = '2';

// Paste into Firebase console → Firestore → Rules, then press Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Public profile: any signed-in user can read one (to show it to call partners),
    // and search a limited number at a time (Find); only its owner can write it,
    // with only the fields the app uses.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 60;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'color', 'photoUri', 'native', 'learning', 'activeLearn',
             'bio', 'hobbies', 'hours', 'utcOffset', 'frame', 'voice', 'languageOnly', 'learnLangs', 'calls',
             'lastSeen', 'inCall'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && (!('hobbies' in request.resource.data) || request.resource.data.hobbies.size() <= 20)
        && (!('learning' in request.resource.data) || request.resource.data.learning.size() <= 3);
      allow delete: if isOwner(uid);

      // Settings, follows, blocks, call history and trust score: owner only.
      // "followers" and "moderation" (report decisions, suspensions) are written only
      // by the server, so the owner can read them but not change them.
      match /private/{doc} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && !(doc in ['followers', 'moderation']);
      }
    }

    // Call requests: the sender and the receiver can watch them; only the server
    // (the app's API) creates and answers them.
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // queue, calls and reports are server-only: no rule here, so the app cannot read them.
  }
}
