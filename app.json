{
  "expo": {
    "name": "Tentalk",
    "slug": "tentalk",
    "owner": "tentalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tentalk.app"
    },
    "android": {
      "package": "com.tentalk.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8EEFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://tentalk.expo.app",
          "apiRoutes": true,
          "asyncRoutes": false
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo from your library."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Tentalk uses the microphone for calls and for recording your voice intro."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Tentalk does not use the camera during calls.",
          "microphonePermission": "Tentalk uses the microphone for calls and for recording your voice intro."
        }
      ]
    ],
    "scheme": "tentalk",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "387e867b-f84f-4cfa-990c-4366d245a535"
      }
    }
  }
}
