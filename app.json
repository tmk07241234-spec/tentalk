{
  "expo": {
    "name": "Tentalk",
    "slug": "tentalk",
    "owner": "tentalk",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tentalk.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.tentalk.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8EEFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://tentalk.expo.app",
          "apiRoutes": true,
          "asyncRoutes": false
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tentalk uses your photo library so you can choose a profile photo that other users will see.",
          "cameraPermission": "Tentalk is voice only and does not use the camera."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Tentalk uses the microphone for voice calls with your practice partner and for recording your voice intro."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Tentalk is voice only and does not use the camera.",
          "microphonePermission": "Tentalk uses the microphone for voice calls with your practice partner and for recording your voice intro."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "tentalk",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "387e867b-f84f-4cfa-990c-4366d245a535"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/387e867b-f84f-4cfa-990c-4366d245a535"
    },
    "locales": {
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "es": "./locales/es.json"
    }
  }
}
